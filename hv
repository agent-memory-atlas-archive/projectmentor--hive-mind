import vocabulary  # noqa: E402  (a table only: the names core reserves; docs/NAMESPACES.md is generated from it)
try:
    import ed25519 as _ed25519  # bundled pure-Python signature verifier
except Exception:
    _ed25519 = None
try:
    import x25519 as _x25519     # bundled pure-Python X25519 (capsule encrypt-to-device)
except Exception:
    _x25519 = None
try:
    import chacha20poly1305 as _chacha   # bundled pure-Python RFC 8439 AEAD (owner-seal + capsules)
except Exception:
    _chacha = None
# 2.0 (#136): a build without its bundled crypto REFUSES to run. It could verify no signature, so it would
# honour entries it cannot check; through 1.x only `hv doctor` failed on it. Every entry point imports this
# module (the CLI, the control plane, the sync daemon), so the refusal is here, at import, not in main().
_MISSING_CRYPTO = [n for n, m in (("ed25519", _ed25519), ("x25519", _x25519), ("chacha20poly1305", _chacha))
                   if m is None]
if _MISSING_CRYPTO:
    sys.stderr.write(f"hv: this build is missing its bundled crypto ({', '.join(m + '.py' for m in _MISSING_CRYPTO)}, "
                     f"beside hv), so it could verify no signature; refusing to run rather than honour entries it "
                     f"cannot check. Restore the install: hive-mind update.\n")
    raise SystemExit(1)

# The agent-facing contract version (hv API + Agent Integration Spec), SemVer MAJOR.MINOR.
# MINOR = additive / backward-compatible (never remove or repurpose existing verbs, flags, or
# output fields within a major). MAJOR = breaking; bump only when unavoidable, keep the previous
# major working as deprecated shims through a window. Authoritative value; docs/AGENT_INTEGRATION.md
# documents the same number. See `hv version`.
CONTRACT_VERSION = "3.1"   # per-version history: docs/CONTRACT_HISTORY.md (newest first); add a new contract's entry there, not on this line (#106)

# --- part loader (3.1) -------------------------------------------------------------------------------
# `hv` is one namespace in several files: the body below the header is executed from these parts, in this
# order, into this module's globals. PARTS is the whole list: no glob, no config, nothing under HIVE_HOME.
# Paths resolve through the real path of this file (as the sys.path line above does), so an installed `hv` runs the
# installed parts. Each part is read as BYTES (hv has non-ASCII literals and no coding cookie) and compiled
# under its own path, so tracebacks name the part. `__file__` stays this file's. A part is not a module:
# imported alone it fails at its first free name. docs/HV_ARCHITECTURE.md ("The parts").
PARTS = (
    "hivemind/parts/01_identity.py",
    "hivemind/parts/02_store_journal.py",
    "hivemind/parts/03_ingest.py",
    "hivemind/parts/04_projection.py",
    "hivemind/parts/05_trust_validation.py",
    "hivemind/parts/06_links_forget.py",
    "hivemind/parts/07_data_commands.py",
    "hivemind/parts/08_read_api.py",
    "hivemind/parts/09_entity_store_ops.py",
    "hivemind/parts/10_agent_loop.py",
    "hivemind/parts/11_release_node.py",
    "hivemind/parts/12_capsules_keys.py",
    "hivemind/parts/13_doctor_status.py",
    "hivemind/parts/14_peers.py",
    "hivemind/parts/15_doctor_control_join.py",
    "hivemind/parts/16_telemetry.py",
    "hivemind/parts/17_cli.py",
)
for _part in PARTS:
    _part = Path(__file__).resolve().parent / _part
    exec(compile(_part.read_bytes(), str(_part), "exec"), globals())
del _part
# --- end part loader ------------------------------------------------------------------------------------
if __name__ == "__main__":
    sys.exit(main() or 0)
